[gd_scene load_steps=2 format=3 uid="uid://impact_vfx"]

[sub_resource type="GDScript" id="GDScript_impact"]
script/source = "extends CPUParticles2D

func _ready() -> void:
	emitting = true
	await get_tree().create_timer(lifetime + 0.1).timeout
	queue_free()

static func spawn(parent: Node, pos: Vector2, color: Color = Color(1.0, 0.9, 0.5), count: int = 12) -> void:
	var scene := preload(\"res://scenes/vfx/impact_vfx.tscn\")
	var vfx: CPUParticles2D = scene.instantiate()
	vfx.global_position = pos
	vfx.color = color
	vfx.amount = count
	parent.add_child(vfx)
"

[node name="ImpactVFX" type="CPUParticles2D"]
